{
  "name": "pusattraining",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro sync && tsc --noEmit",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "schedules:discover": "node scripts/discover-schedules.mjs",
    "test:schedules:discover": "node --test scripts/discover-schedules.test.mjs",
    "schedules:generate": "node scripts/generate-schedule-frontmatter.mjs",
    "test:schedules:generate": "node --test scripts/generate-schedule-frontmatter.test.mjs",
    "test:schedules:mappings": "node --test scripts/schedule-mapping-config.test.mjs",
    "test:schedules:routing": "node --test scripts/schedule-routing.test.mjs",
    "test:schedules:sitemap": "node --test scripts/sitemap-lastmod.test.mjs"
  },
  "overrides": {
    "astro": "7.4.0",
    "@astrojs/compiler-binding": "0.5.2",
    "vite": "8.3.4",
    "rolldown": "1.2.14",
    "@rolldown/binding-linux-x64-gnu": "1.2.14"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  }
}
