---
interface Props { eyebrow?: string; noticeTitle: string; noticeDescription: string; }
const { eyebrow = 'CATATAN PROGRAM', noticeTitle, noticeDescription } = Astro.props;
---
<aside class="training-detail-intro mt-8 rounded-2xl border border-amber-200 bg-amber-50/70 p-5 sm:p-6" aria-label={noticeTitle}>
  <div class="training-detail-intro__content max-w-4xl">
    <p class="training-detail-intro__eyebrow text-[.68rem] font-extrabold uppercase tracking-[.16em] text-amber-800">{eyebrow}</p>
    <h2 class="training-detail-intro__notice-title mt-2 text-base font-bold text-slate-950">{noticeTitle}</h2>
    <p class="training-detail-intro__notice-description mt-2 text-sm leading-7 text-slate-700">{noticeDescription}</p>
  </div>
</aside>