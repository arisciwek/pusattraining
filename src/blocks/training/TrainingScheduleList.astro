---
import type { CollectionEntry } from 'astro:content';
import ScheduleCard from '../../components/schedule/ScheduleCard.astro';

type ScheduleEntry = CollectionEntry<'schedules'>;

interface Props {
  id?: string;
  title: string;
  eyebrow?: string;
  allLabel?: string;
  emptyMessage: string;
  schedules: ScheduleEntry[];
  trainingSlug: string;
}

const {
  id = 'jadwal-pelatihan',
  title,
  eyebrow = 'JADWAL PELATIHAN',
  allLabel = 'Semua jadwal',
  emptyMessage,
  schedules,
  trainingSlug,
} = Astro.props;

type TimelineStatus = 'available' | 'ongoing' | 'past';

function dateKeyInTimezone(value: string, timezone: string): string {
  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return value;
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: timezone,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).formatToParts(new Date(value));
  const part = (type: string) => parts.find((item) => item.type === type)?.value ?? '';
  return `${part('year')}-${part('month')}-${part('day')}`;
}

function getTimelineStatus(schedule: ScheduleEntry): TimelineStatus | undefined {
  if (schedule.data.status === 'cancelled' || schedule.data.status === 'postponed') return undefined;
  const timezone = schedule.data.timezone || 'Asia/Jakarta';
  const today = dateKeyInTimezone(new Date().toISOString(), timezone);
  const start = dateKeyInTimezone(schedule.data.startDate, timezone);
  const end = dateKeyInTimezone(schedule.data.endDate, timezone);
  if (end < today) return 'past';
  if (start <= today) return 'ongoing';
  return 'available';
}

// Tampilkan batch terbaru lebih dahulu, termasuk arsip jadwal yang sudah lewat.
const sortedSchedules = [...schedules].sort((a, b) => {
  const dateDifference = Date.parse(b.data.startDate) - Date.parse(a.data.startDate);
  return dateDifference || a.data.batchNo.localeCompare(b.data.batchNo, 'id', { numeric: true });
});
---
<section id={id} class="training-schedule-list mt-12" aria-labelledby={`${id}-title`}>
  <div class="training-schedule-list__heading flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="training-schedule-list__eyebrow text-xs font-bold uppercase tracking-[0.14em] text-amber-700">{eyebrow}</p>
      <h2 id={`${id}-title`} class="training-schedule-list__title mt-2 text-2xl font-bold tracking-tight text-slate-950">{title}</h2>
    </div>
    {sortedSchedules.length > 0 && (
      <a class="training-schedule-list__all text-sm font-semibold text-slate-600 hover:text-amber-700" href="/jadwal/">
        {allLabel} <span aria-hidden="true">→</span>
      </a>
    )}
  </div>

  {sortedSchedules.length > 0 ? (
    <>
      <ul class="training-schedule-list__legend mt-5 flex flex-wrap gap-x-5 gap-y-2 text-xs font-semibold text-slate-600" aria-label="Keterangan status jadwal">
        <li class="training-schedule-list__legend-item"><span class="training-schedule-list__legend-dot training-schedule-list__legend-dot--available" aria-hidden="true"></span>Tersedia</li>
        <li class="training-schedule-list__legend-item"><span class="training-schedule-list__legend-dot training-schedule-list__legend-dot--ongoing" aria-hidden="true"></span>Sedang berlangsung</li>
        <li class="training-schedule-list__legend-item"><span class="training-schedule-list__legend-dot training-schedule-list__legend-dot--past" aria-hidden="true"></span>Sudah terlewati</li>
      </ul>
      <div class="training-schedule-list__grid mt-5 grid gap-5 lg:grid-cols-2">
        {sortedSchedules.map((schedule) => <ScheduleCard schedule={schedule} trainingSlug={trainingSlug} timelineStatus={getTimelineStatus(schedule)} />)}
      </div>
    </>
  ) : (
    <p class="training-schedule-list__empty mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-sm leading-7 text-slate-600">{emptyMessage}</p>
  )}
</section>

<script>
  const getDateInTimezone = (value: string, timezone: string): string => {
    // Nilai YYYY-MM-DD adalah tanggal kalender, bukan instant UTC.
    if (/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return value;

    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: timezone,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).formatToParts(new Date(value));

    const part = (type: string) => parts.find((item) => item.type === type)?.value ?? '';
    return `${part('year')}-${part('month')}-${part('day')}`;
  };

  document.querySelectorAll<HTMLElement>('.training-schedule-list .schedule-card').forEach((card) => {
    const start = card.dataset.startDate;
    const end = card.dataset.endDate;
    const timezone = card.dataset.timezone || 'Asia/Jakarta';
    const editorialStatus = card.dataset.editorialStatus;

    if (!start || !end || editorialStatus === 'cancelled' || editorialStatus === 'postponed') return;

    const today = getDateInTimezone(new Date().toISOString(), timezone);
    const localStart = getDateInTimezone(start, timezone);
    const localEnd = getDateInTimezone(end, timezone);

    const status = localEnd < today
      ? { key: 'past', label: 'Sudah terlewati' }
      : localStart <= today
        ? { key: 'ongoing', label: 'Sedang berlangsung' }
        : { key: 'available', label: 'Tersedia' };

    const badge = card.querySelector<HTMLElement>('.schedule-card__status');
    if (!badge) return;

    badge.classList.remove(
      'schedule-card__status--scheduled',
      'schedule-card__status--ongoing',
      'schedule-card__status--completed',
    );
    badge.classList.add(`schedule-card__status--${status.key}`);
    badge.textContent = status.label;
    card.dataset.timelineStatus = status.key;
  });
</script>

<style>
  .training-schedule-list__legend-item { display: inline-flex; align-items: center; gap: 0.5rem; }
  .training-schedule-list__legend-dot { width: 0.625rem; height: 0.625rem; border-radius: 9999px; }
  .training-schedule-list__legend-dot--available { background: #16a34a; }
  .training-schedule-list__legend-dot--ongoing { background: #eab308; }
  .training-schedule-list__legend-dot--past { background: #dc2626; }
</style>
