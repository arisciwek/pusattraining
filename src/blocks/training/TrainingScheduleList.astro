---
import type { CollectionEntry } from 'astro:content';
import ScheduleCard from '../../components/schedule/ScheduleCard.astro';

type ScheduleEntry = CollectionEntry<'schedules'>;

interface Props {
  title: string;
  eyebrow?: string;
  allLabel?: string;
  emptyMessage: string;
  schedules: ScheduleEntry[];
  trainingSlug: string;
}

const {
  title,
  eyebrow = 'BATCH TERSEDIA',
  allLabel = 'Semua jadwal',
  emptyMessage,
  schedules,
  trainingSlug,
} = Astro.props;
---
<section class="training-schedule-list mt-12">
  <div class="training-schedule-list__heading flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="training-schedule-list__eyebrow text-xs font-bold uppercase tracking-[0.14em] text-amber-700">{eyebrow}</p>
      <h2 class="training-schedule-list__title mt-2 text-2xl font-bold tracking-tight text-slate-950">{title}</h2>
    </div>
    {schedules.length > 0 && (
      <a class="training-schedule-list__all text-sm font-semibold text-slate-600 hover:text-amber-700" href="/jadwal/">
        {allLabel} <span aria-hidden="true">→</span>
      </a>
    )}
  </div>

  {schedules.length > 0 ? (
    <div class="training-schedule-list__grid mt-6 grid gap-5 lg:grid-cols-2">
      {schedules.map((schedule) => <ScheduleCard schedule={schedule} trainingSlug={trainingSlug} />)}
    </div>
  ) : (
    <p class="training-schedule-list__empty mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-sm leading-7 text-slate-600">{emptyMessage}</p>
  )}
</section>
