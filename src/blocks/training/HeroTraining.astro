---
import type { TrainingDetailBlock } from '../types';

interface TrustItem {
  icon: string;
  label: string;
}

interface Props {
  eyebrow: string;
  certBadge?: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  imageSrcset?: string;
  imageSizes?: string;
  imageWidth?: string;
  imageHeight?: string;
  deliveryMode?: 'online' | 'offline' | 'mixed';
  ctaLabel?: string;
  ctaHref?: string;
  trustItems?: TrustItem[];
}

const {
  eyebrow,
  certBadge,
  title,
  description,
  image,
  imageAlt,
  imageSrcset,
  imageSizes = '(max-width: 480px) 360px, (max-width: 900px) calc(100vw - 40px), (max-width: 1280px) 65vw, 800px',
  imageWidth = '800',
  imageHeight = '662',
  deliveryMode,
  ctaLabel = 'Lihat biaya & daftar',
  ctaHref = '#pendaftaran',
  trustItems = [],
} = Astro.props;
---

<section class="hero-training">
  <div class="hero-training__main">
    <div class="hero-training__eyebrow">
      <span class="hero-training__status-dot" aria-hidden="true"></span>
      <span>{eyebrow}</span>
      {certBadge && <span class="hero-training__cert-tag">{certBadge}</span>}
    </div>
    <h1 id="course-title" class="hero-training__title">{title}</h1>
    <p class="hero-training__summary">{description}</p>
    {ctaLabel && ctaHref && (
      <a class="hero-training__mobile-link" href={ctaHref}>
        {ctaLabel}
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 12h16m-6-6 6 6-6 6"></path>
        </svg>
      </a>
    )}
    <div class="hero-training__trust">
      {trustItems.map((item) => (
        <span class="hero-training__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
          {item.label}
        </span>
      ))}
    </div>
  </div>

  <figure class="hero-training__image">
    <img
      src={image}
      {...imageSrcset && { srcset: imageSrcset }}
      {...imageSizes && { sizes: imageSizes }}
      width={imageWidth}
      height={imageHeight}
      alt={imageAlt}
      fetchpriority="high"
      decoding="async"
    />
    <figcaption class="hero-training__caption">
      {certBadge && (
        <span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 2 8 4v6c0 5-8 10-8 10S4 17 4 12V6Z"></path>
            <path d="m8 12 3 3 5-6"></path>
          </svg>
          Sertifikasi {certBadge}
        </span>
      )}
      {deliveryMode && (
        <span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2"></rect>
            <path d="M8 21h8M12 17v4"></path>
          </svg>
          {deliveryMode === 'online' ? 'Online' : deliveryMode === 'offline' ? 'Tatap Muka' : 'Online / Tatap Muka'}
        </span>
      )}
    </figcaption>
  </figure>
</section>
<style>
  .hero-training {
    margin-bottom: 2.5rem;
  }

  .hero-training__main {
    display: flex;
    flex-direction: column;
  }

  .hero-training__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #b45309;
  }

  .hero-training__status-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background-color: #10b981;
  }

  .hero-training__cert-tag {
    display: inline-block;
    border-radius: 9999px;
    background-color: #0f172a;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #ffffff;
  }

  .hero-training__title {
    margin-top: 0.75rem;
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: #0f172a;
  }

  @media (min-width: 640px) {
    .hero-training__title {
      font-size: 3rem;
    }
  }

  .hero-training__summary {
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 2;
    color: #475569;
  }

  .hero-training__mobile-link {
    margin-top: 1.25rem;
    display: inline-flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.75rem;
    background-color: #0f172a;
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: #ffffff;
    transition: background-color 0.15s ease;
  }

  .hero-training__mobile-link:hover {
    background-color: #d97706;
  }

  @media (min-width: 1024px) {
    .hero-training__mobile-link {
      display: none;
    }
  }

  .hero-training__trust {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
  }

  .hero-training__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .hero-training__image {
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    background-color: #f1f5f9;
  }

  .hero-training__image img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .hero-training__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    border-top: 1px solid #f1f5f9;
    padding: 0.75rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
  }

  .hero-training__caption span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
</style>