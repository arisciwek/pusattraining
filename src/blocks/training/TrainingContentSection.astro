---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  items: { title: string; description?: string }[];
}
const { id, eyebrow, title, description, items } = Astro.props;
---
<section id={id} class="training-content-section mt-14 scroll-mt-24">
  <header class="training-content-section__header max-w-3xl">
    {eyebrow && <p class="training-content-section__eyebrow text-xs font-bold uppercase tracking-[0.16em] text-amber-700">{eyebrow}</p>}
    <h2 class="training-content-section__title mt-2 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">{title}</h2>
    {description && <p class="training-content-section__description mt-3 text-base leading-8 text-slate-600">{description}</p>}
  </header>
  {items.length > 0 && (
    <ol class="training-content-section__list mt-7 grid gap-4 sm:grid-cols-2">
      {items.map((item, index) => (
        <li class="training-content-section__item flex gap-4 rounded-2xl border border-slate-200 bg-white p-5">
          <span class="training-content-section__number flex size-9 shrink-0 items-center justify-center rounded-full bg-slate-950 text-sm font-bold text-white">{String(index + 1).padStart(2, '0')}</span>
          <div class="training-content-section__item-content">
            <h3 class="training-content-section__item-title font-bold leading-6 text-slate-950">{item.title}</h3>
            {item.description && <p class="training-content-section__item-description mt-2 text-sm leading-6 text-slate-600">{item.description}</p>}
          </div>
        </li>
      ))}
    </ol>
  )}
</section>
