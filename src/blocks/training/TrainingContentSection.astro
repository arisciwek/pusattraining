---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  items: { title: string; description?: string }[];
}
const { id, eyebrow, title, description, items } = Astro.props;
---
<section id={id} class="training-content-section mt-14 scroll-mt-24">
  <header class="training-content-section__header max-w-3xl">
    {eyebrow && <p class="training-content-section__eyebrow text-sm font-semibold text-amber-800">{eyebrow}</p>}
    <h2 class="training-content-section__title mt-2 text-2xl font-extrabold leading-tight tracking-tight text-slate-950 sm:text-3xl">{title}</h2>
    {description && <p class="training-content-section__description mt-3 text-base leading-8 text-slate-600">{description}</p>}
  </header>
  {items.length > 0 && (
    <ol class="training-content-section__list mt-7 grid gap-x-12 sm:grid-cols-2">
      {items.map((item, index) => (
        <li class="training-content-section__item flex gap-4 border-t border-slate-200 py-5">
          <span class="training-content-section__number w-7 shrink-0 pt-0.5 font-display text-sm font-bold tabular-nums text-amber-700">{String(index + 1).padStart(2, '0')}</span>
          <div class="training-content-section__item-content">
            <h3 class="training-content-section__item-title font-display text-base font-bold leading-6 text-slate-950">{item.title}</h3>
            {item.description && <p class="training-content-section__item-description mt-2 text-sm leading-6 text-slate-600">{item.description}</p>}
          </div>
        </li>
      ))}
    </ol>
  )}
</section>
