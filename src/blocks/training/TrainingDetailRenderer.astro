---
import HeroTraining from './HeroTraining.astro';
import TrainingDetailIntro from './TrainingDetailIntro.astro';
import TrainingScheduleList from './TrainingScheduleList.astro';
import TrainingSummary from './TrainingSummary.astro';
import TrainingContentSection from './TrainingContentSection.astro';
import TrainingFaq from './TrainingFaq.astro';
import TrainingCta from './TrainingCta.astro';
import type { TrainingDetailBlock } from '../types';
import type { CollectionEntry } from 'astro:content';
type ScheduleEntry = CollectionEntry<'schedules'>;
interface Props {
  blocks: TrainingDetailBlock[]; title: string; description: string; schedules: ScheduleEntry[]; trainingSlug: string;
  image?: string; imageAlt?: string;
  hero?: {
    title?: string; imageAlt?: string; eyebrow?: string; certBadge?: string; description?: string; deliveryMode?: 'online' | 'offline' | 'mixed';
    ctaLabel?: string; ctaHref?: string; trustItems?: { icon: string; label: string }[];
    price?: string; priceNote?: string; duration?: string; imageSrcset?: string; imageSizes?: string; imageWidth?: string; imageHeight?: string;
  };
}
const { blocks, title, description, schedules, trainingSlug, image, imageAlt = title, hero } = Astro.props;
function slugifySectionTitle(value: string): string {
  return value.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
const introBlocks = blocks.filter((block) => block.type === 'training-detail-intro');
const contentBlocks = blocks.filter((block) => block.type !== 'training-detail-intro');
const navigationItems = contentBlocks.flatMap((block) => {
  if (block.type === 'training-summary') return [{ id: block.id ?? 'ringkasan-program', label: 'Ringkasan' }];
  if (block.type === 'training-schedule-list') return [{ id: block.id ?? 'jadwal-pelatihan', label: 'Jadwal' }];
  if (block.type === 'training-content-section') return [{ id: block.id ?? `bagian-${slugifySectionTitle(block.title)}`, label: block.title }];
  if (block.type === 'training-faq') return [{ id: block.id ?? 'faq-pelatihan', label: 'FAQ' }];
  return [];
});
---
<div class="training-detail-renderer">
  {hero && <HeroTraining eyebrow={hero.eyebrow ?? 'PROGRAM PELATIHAN'} certBadge={hero.certBadge} title={hero.title ?? title} description={hero.description ?? description} image={image ?? ''} imageAlt={hero.imageAlt ?? imageAlt} imageSrcset={hero.imageSrcset} imageSizes={hero.imageSizes} imageWidth={hero.imageWidth} imageHeight={hero.imageHeight} deliveryMode={hero.deliveryMode} ctaLabel={hero.ctaLabel} ctaHref={hero.ctaHref} trustItems={hero.trustItems} price={hero.price} priceNote={hero.priceNote} duration={hero.duration} schedules={schedules} />}
  {introBlocks.map((block) => block.type === 'training-detail-intro' ? <TrainingDetailIntro eyebrow={block.eyebrow} noticeTitle={block.noticeTitle} noticeDescription={block.noticeDescription} /> : null)}
  {navigationItems.length > 1 && (
    <nav class="training-detail-renderer__navigation" aria-label="Navigasi bagian program" data-section-nav>
      <div class="training-detail-renderer__navigation-scroller" data-section-nav-scroller>
        <ul class="training-detail-renderer__navigation-list">
          {navigationItems.map((item) => (
            <li class="training-detail-renderer__navigation-item">
              <a class="training-detail-renderer__navigation-link" href={`#${item.id}`} title={item.label}><span class="training-detail-renderer__navigation-label">{item.label}</span></a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )}
  {contentBlocks.map((block) => {
    if (block.type === 'training-summary') return <TrainingSummary id={block.id ?? 'ringkasan-program'} eyebrow={block.eyebrow} items={block.items} />;
    if (block.type === 'training-content-section') return <TrainingContentSection id={block.id ?? `bagian-${slugifySectionTitle(block.title)}`} eyebrow={block.eyebrow} title={block.title} description={block.description} items={block.items} />;
    if (block.type === 'training-faq') return <TrainingFaq id={block.id ?? 'faq-pelatihan'} eyebrow={block.eyebrow} title={block.title} description={block.description} items={block.items} />;
    if (block.type === 'training-cta') return <TrainingCta eyebrow={block.eyebrow} title={block.title} description={block.description} actionLabel={block.actionLabel} secondaryLabel={block.secondaryLabel} secondaryHref={block.secondaryHref} />;
    if (block.type === 'training-schedule-list') return <TrainingScheduleList id={block.id ?? 'jadwal-pelatihan'} title={block.title} eyebrow={block.eyebrow} allLabel={block.allLabel} emptyMessage={block.emptyMessage} schedules={schedules} trainingSlug={trainingSlug} />;
    return null;
  })}
  {!contentBlocks.some((block) => block.type === 'training-cta') && <TrainingCta eyebrow="KONSULTASI PROGRAM" title={`Tertarik mengikuti ${title}?`} description="Hubungi Tiara untuk menanyakan informasi program, jadwal, dan proses pendaftaran." actionLabel="Chat Tiara via WhatsApp" />}
</div>
<script>
  // Scrollspy for the section navigation: marks the current section, keeps the active tab in view,
  // toggles the "stuck" shadow and the edge fades that hint the tab list can be scrolled.
  const nav = document.querySelector<HTMLElement>('[data-section-nav]');
  const scroller = nav?.querySelector<HTMLElement>('[data-section-nav-scroller]');
  if (nav && scroller) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.training-detail-renderer__navigation-link'));
    const targets = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    const header = document.querySelector<HTMLElement>('.site-header');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = -1;
    let frame = 0;

    const setCurrent = (index: number) => {
      if (index === current) return;
      current = index;
      links.forEach((link, i) => (i === index ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current')));
      const link = links[index];
      if (link) {
        const left = link.offsetLeft - (scroller.clientWidth - link.offsetWidth) / 2;
        scroller.scrollTo({ left, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      }
    };

    const update = () => {
      frame = 0;
      const headerHeight = header?.offsetHeight ?? 0;
      const offset = headerHeight + nav.offsetHeight + 24;
      let index = -1;
      targets.forEach((target, i) => {
        if (target && target.getBoundingClientRect().top <= offset) index = i;
      });
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) index = targets.length - 1;
      setCurrent(index);
      nav.toggleAttribute('data-stuck', nav.getBoundingClientRect().top <= headerHeight + 1);
      nav.toggleAttribute('data-fade-start', scroller.scrollLeft > 4);
      nav.toggleAttribute('data-fade-end', scroller.scrollLeft + scroller.clientWidth < scroller.scrollWidth - 4);
    };

    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    scroller.addEventListener('scroll', schedule, { passive: true });
    update();
  }
</script>
