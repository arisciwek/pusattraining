---
import type { CollectionEntry } from 'astro:content';
import { certificationLabel, certificationName } from '../../lib/certification';
import { CONTACT_PERSON, getContactWhatsAppHref } from '../../lib/contact';
type ScheduleEntry = CollectionEntry<'schedules'>;
interface Props { title: string; certBadge?: string; price?: string; priceNote?: string; duration?: string; deliveryLabel?: string; nextSchedule?: ScheduleEntry; }
const { title, certBadge, price, priceNote, duration, deliveryLabel, nextSchedule } = Astro.props;
const certLabel = certificationLabel(certBadge);
const certName = certificationName(certBadge);
const durationIsLong = (duration?.length ?? 0) > 26;
const whatsappHref = getContactWhatsAppHref(`Halo ${CONTACT_PERSON}, saya ingin konsultasi pendaftaran ${title} di Pusattraining. Mohon informasi jadwal, biaya, dan persyaratannya.`);
const inhouseHref = getContactWhatsAppHref(`Halo ${CONTACT_PERSON}, kami ingin meminta informasi penawaran in-house training untuk program ${title}.`);
---
<aside class="training-registration rounded-2xl border border-slate-200 bg-white p-5 shadow-xl shadow-slate-900/10 sm:p-6" aria-label={`Biaya dan pendaftaran ${title}`}>
  <div class="training-registration__top flex flex-wrap items-center justify-between gap-3">
    <span class="training-registration__kicker text-sm font-semibold text-amber-800">Investasi pelatihan</span>
    {certBadge && <span class="training-registration__cert inline-flex items-center gap-1.5 rounded-full bg-slate-950 px-3 py-1.5 text-[.68rem] font-bold text-white"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 8 4v6c0 5-8 10-8 10S4 17 4 12V6Z"></path><path d="m8 12 3 3 5-6"></path></svg>{certLabel}</span>}
  </div>
  <p class="training-registration__price mt-5 text-3xl font-black tracking-tight text-slate-950">{price ?? 'Hubungi kami'}{price && <span class="ml-1 text-sm font-semibold tracking-normal text-slate-500">/ peserta</span>}</p>
  <p class="training-registration__price-note mt-2 text-sm leading-6 text-slate-500">{priceNote ?? 'Konfirmasikan biaya, cakupan program, dan persyaratan kepada tim kami.'}</p>
  <dl class="training-registration__facts mt-5 divide-y divide-slate-100 border-y border-slate-100">
    {duration && <div class:list={["training-registration__fact flex gap-x-4 gap-y-1.5 py-3", durationIsLong ? "flex-col items-start" : "items-center justify-between"]}><dt class="inline-flex items-center gap-2 text-sm text-slate-500"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 11h18"></path></svg>Durasi</dt><dd class:list={["text-sm font-bold leading-6 text-slate-900", durationIsLong ? "pl-[1.625rem] text-left" : "text-right"]}>{duration}</dd></div>}
    {deliveryLabel && <div class="training-registration__fact flex items-center justify-between gap-4 py-3"><dt class="inline-flex items-center gap-2 text-sm text-slate-500"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>Pelaksanaan</dt><dd class="text-right text-sm font-bold text-slate-900">{deliveryLabel}</dd></div>}
    {certBadge && <div class="training-registration__fact flex items-center justify-between gap-4 py-3"><dt class="inline-flex items-center gap-2 text-sm text-slate-500"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 2h9l5 5v15H5Z M14 2v6h5M9 12h6M9 16h6"></path></svg>Sertifikasi</dt><dd class="text-right text-sm font-bold text-slate-900">{certName}</dd></div>}
  </dl>
  <div class="training-registration__next mt-5 rounded-xl bg-amber-50 p-4">
    <span class="training-registration__kicker text-sm font-semibold text-amber-800">Jadwal terdekat</span>
    {nextSchedule ? <><strong class="mt-2 block text-sm leading-6 text-slate-950">{nextSchedule.data.dateLabel}</strong><a class="mt-2 inline-flex items-center gap-1.5 text-xs font-bold text-amber-800 underline decoration-amber-300 underline-offset-4 hover:text-amber-950" href="#jadwal-pelatihan">Lihat pilihan jadwal <span aria-hidden="true">→</span></a></> : <p class="mt-2 text-sm leading-6 text-slate-600">Belum ada batch mendatang yang dipublikasikan. Hubungi tim untuk menanyakan rencana pelaksanaan.</p>}
  </div>
  <a class="training-registration__primary mt-5 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-slate-950 px-5 py-3 text-sm font-extrabold text-white no-underline transition-colors hover:bg-amber-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-950" href={whatsappHref} target="_blank" rel="noopener noreferrer"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.6 7.8L3 21l1.7-4.4A9 9 0 1 1 21 11.5Z"></path><path d="M8 7.5c0 4 2.5 6.5 6.5 7l1-2-2-1-1 1a8 8 0 0 1-3-3l1-1-1-2Z"></path></svg>Daftar via WhatsApp <span aria-hidden="true">↗</span></a>
  <p class="training-registration__contact-note mt-2 text-center text-xs leading-5 text-slate-500">Tanya jadwal, biaya, dan persyaratan sebelum mendaftar.</p>
  <div class="training-registration__inhouse mt-5 flex gap-3 border-t border-slate-100 pt-5">
    <span class="training-registration__inhouse-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-700" aria-hidden="true"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="3"></circle><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 4a3 3 0 0 1 0 6M21 21v-3a6 6 0 0 0-4-5"></path></svg></span>
    <div class="training-registration__inhouse-content"><strong class="block text-sm font-bold text-slate-900">Untuk tim perusahaan?</strong><a class="mt-1 inline-flex items-center gap-1 text-xs font-bold text-amber-800 underline decoration-amber-300 underline-offset-4 hover:text-amber-950" href={inhouseHref} target="_blank" rel="noopener noreferrer">Minta penawaran in-house <span aria-hidden="true">→</span></a></div>
  </div>
</aside>