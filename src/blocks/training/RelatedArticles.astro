---
import type { CollectionEntry } from 'astro:content';
import { DEFAULT_ARTICLE_IMAGE } from '../../lib/site';

interface Props {
  articles: CollectionEntry<'articles'>[];
  id?: string;
  eyebrow?: string;
  title?: string;
}

const {
  articles,
  id = 'artikel-terkait',
  eyebrow = 'MATERI TERKAIT',
  title = 'Artikel Terkait',
} = Astro.props;

const formatDate = (value: string) => new Date(value).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Jakarta',
});
---

{articles.length > 0 && (
  <section id={id} class="training-related-articles mt-14" aria-labelledby={`${id}-title`}>
    <p class="training-related-articles__eyebrow text-xs font-bold uppercase tracking-wider text-amber-700">{eyebrow}</p>
    <h2 id={`${id}-title`} class="training-related-articles__title mt-2 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">{title}</h2>
    <div class="training-related-articles__grid mt-6 grid gap-5 sm:grid-cols-2">
      {articles.map(({ data }) => (
        <article class="training-related-articles__card group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-200 hover:-translate-y-1 hover:border-amber-300 hover:shadow-lg">
          <a class="training-related-articles__image-link block aspect-[16/9] overflow-hidden bg-slate-100" href={`/artikel/${data.slug}/`} aria-label={`Baca ${data.title}`}>
            <img class="training-related-articles__image h-full w-full object-cover transition duration-300 group-hover:scale-105" src={data.image || DEFAULT_ARTICLE_IMAGE} alt={data.title} loading="lazy" decoding="async" />
          </a>
          <div class="training-related-articles__content flex flex-1 flex-col p-5">
            <p class="training-related-articles__category text-xs font-semibold text-amber-700">{data.category}</p>
            <h3 class="training-related-articles__card-title mt-2 text-lg font-bold leading-snug text-slate-950">
              <a class="training-related-articles__card-link transition-colors hover:text-amber-800" href={`/artikel/${data.slug}/`}>{data.title}</a>
            </h3>
            <p class="training-related-articles__description mt-2 line-clamp-3 text-sm leading-7 text-slate-600">{data.description}</p>
            <time class="training-related-articles__date mt-auto pt-4 text-xs text-slate-500" datetime={data.pubDate}>{formatDate(data.pubDate)}</time>
          </div>
        </article>
      ))}
    </div>
  </section>
)}
