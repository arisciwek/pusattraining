---
import { blockRegistry } from './registry';
import type { PageBlock } from './types';

interface Props {
  blocks: PageBlock[];
  categories?: { title: string; description: string; href: string }[];
}

const { blocks, categories = [] } = Astro.props;
---
<div class="page-blocks">
  {blocks.map((block) => {
    const Component = blockRegistry[block.type] as typeof blockRegistry[PageBlock['type']];
    const { type: _type, ...props } = block;

    return block.type === 'training-catalog'
      ? <Component {...props} categories={categories} />
      : <Component {...props} />;
  })}
</div>
