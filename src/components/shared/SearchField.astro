---
interface Props { id: string; label: string; name?: string; placeholder?: string; value?: string; type?: 'search' | 'text'; }
const { id, label, name = 'q', placeholder = 'Cari pelatihan…', value = '', type = 'search' } = Astro.props;
---
<div class="search-field">
  <label class="search-field__label" for={id}>{label}</label>
  <div class="search-field__control">
    <svg class="search-field__icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    <input class="search-field__input" id={id} name={name} type={type} value={value} placeholder={placeholder} />
  </div>
</div>