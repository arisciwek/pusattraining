---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, description, align = 'left', class: className = '' } = Astro.props;
const alignment = align === 'center' ? 'mx-auto text-center' : 'text-left';
---

<header class={['section-heading max-w-3xl', alignment, className].filter(Boolean).join(' ')}>
  {eyebrow && <p class="section-heading__eyebrow mb-3 text-xs font-bold uppercase tracking-[0.18em] text-amber-700">{eyebrow}</p>}
  <h2 class="section-heading__title text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">{title}</h2>
  {description && <p class="section-heading__description mt-4 text-base leading-7 text-slate-600 sm:text-lg">{description}</p>}
</header>
