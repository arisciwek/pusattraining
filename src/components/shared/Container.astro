---
interface Props {
  as?: 'div' | 'section' | 'main' | 'header' | 'footer';
  size?: 'wide' | 'default' | 'narrow';
  class?: string;
}

const { as: Tag = 'div', size = 'default', class: className = '' } = Astro.props;
const sizes = {
  wide: 'max-w-screen-2xl',
  default: 'max-w-7xl',
  narrow: 'max-w-4xl',
};
---

<Tag class={['site-container mx-auto w-full px-5 sm:px-6 lg:px-8', sizes[size], className].filter(Boolean).join(' ')}>
  <slot />
</Tag>
