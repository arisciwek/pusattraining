---
interface Props { title: string; description?: string; items: { title: string; description: string; icon?: string }[]; }
const { title, description, items } = Astro.props;
---
<section class="benefits-block" aria-labelledby="benefits-block-title"><header class="benefits-block__header"><h2 class="benefits-block__title" id="benefits-block-title">{title}</h2>{description && <p class="benefits-block__description">{description}</p>}</header><div class="benefits-block__grid">{items.map((item, index) => <article class="benefits-block__item"><span class="benefits-block__index">{String(index + 1).padStart(2, '0')}</span>{item.icon && <span class="benefits-block__icon" aria-hidden="true">{item.icon}</span>}<h3 class="benefits-block__item-title">{item.title}</h3><p class="benefits-block__item-description">{item.description}</p></article>)}</div></section>