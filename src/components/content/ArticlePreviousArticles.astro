---
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
  articles: CollectionEntry<'articles'>[];
  limit?: number;
}

const { article, articles, limit = 5 } = Astro.props;

const previousArticles = articles
  .filter((item) => !item.data.draft && item.data.type === 'article' && item.data.id < article.data.id)
  .sort((a, b) => b.data.id - a.data.id)
  .slice(0, limit);
---

{previousArticles.length > 0 && (
  <section
    id="artikel-sebelumnya"
    class="article-previous rounded-3xl border border-slate-200 bg-white p-5 shadow-sm"
    aria-labelledby="artikel-sebelumnya-title"
  >
    <p class="article-previous__eyebrow text-xs font-bold uppercase tracking-wider text-amber-700">
      Artikel sebelumnya
    </p>
    <h2
      id="artikel-sebelumnya-title"
      class="article-previous__title mt-2 text-lg font-bold tracking-tight text-slate-950"
    >
      Baca juga artikel lainnya
    </h2>
    <ol class="article-previous__list mt-5 space-y-3">
      {previousArticles.map((item) => (
        <li class="article-previous__item rounded-2xl border-l-4 border-slate-200 bg-slate-50 pl-4 pr-4 py-3 transition hover:border-amber-500 hover:bg-amber-50">
          <a
            href={`/artikel/${item.data.slug}/`}
            class="article-previous__link block text-sm font-semibold leading-6 text-slate-800 no-underline hover:text-amber-800"
          >
            {item.data.title}
          </a>
          <p class="article-previous__meta mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
            <span class="article-previous__category font-semibold text-amber-700">{item.data.category}</span>
            <time class="article-previous__date" datetime={item.data.pubDate}>
              {new Date(item.data.pubDate).toLocaleDateString('id-ID', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
                timeZone: 'Asia/Jakarta',
              })}
            </time>
          </p>
        </li>
      ))}
    </ol>
  </section>
)}
