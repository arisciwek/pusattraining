---
interface Props {
  eyebrow: string;
  heading: string;
  highlight?: string;
  lead: string;
  leadHtml?: string;
  /** URL gambar hero (optional, pakai default jika tidak ada). */
  image?: string;
  imageAlt?: string;
  /** Slot untuk media kustom (gambar/video). */
}

const { eyebrow, heading, highlight, lead, leadHtml, image, imageAlt } = Astro.props;
const imageUrl = image ? new URL(image, Astro.site).href : '/images/default-article.svg';
const imageAltText = imageAlt ?? heading;
---

<style>
  .hero-article {
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    background: linear-gradient(180deg, var(--bg-subtle) 0%, transparent 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }

  .hero-copy {
    max-width: 48rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hero-title {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hero-title .highlight {
    color: var(--accent);
    position: relative;
  }

  .hero-lead {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--muted);
    max-width: 42rem;
  }

  .hero-media {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--bg-muted);
    aspect-ratio: 16/9;
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.15);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-media {
      order: -1;
      margin-bottom: 1.5rem;
    }
  }
</style>

<section class="hero-article" aria-labelledby="article-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" aria-hidden="true">{eyebrow}</p>
      <h1 id="article-title" class="hero-title">
        {heading}
        {highlight && <span class="highlight"> {highlight}</span>}
      </h1>
      {leadHtml ? (
        <p class="hero-lead" set:html={leadHtml} />
      ) : (
        <p class="hero-lead">{lead}</p>
      )}
      <slot name="meta" />
      <slot name="actions" />
    </div>
    <div class="hero-media">
      <img
        src={imageUrl}
        alt={imageAltText}
        width="1200"
        height="630"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>