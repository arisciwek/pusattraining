---
interface Props { label?: string; tabs: { id: string; title: string; content: string; href?: string }[]; }
const { label = 'Pilih informasi', tabs } = Astro.props;
---
<div class="detail-tabs" data-detail-tabs><div class="detail-tabs__list" role="tablist" aria-label={label}>{tabs.map((tab, index) => <button class="detail-tabs__tab" type="button" role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>{tab.title}</button>)}</div>{tabs.map((tab, index) => <section class="detail-tabs__panel" role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} hidden={index !== 0}><p>{tab.content}</p>{tab.href && <a class="detail-tabs__link" href={tab.href}>Pelajari lebih lanjut →</a>}</section>)}</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-detail-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const activate = (active: HTMLButtonElement, focus = false) => {
      tabs.forEach((tab) => {
        const selected = tab === active;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${tab.getAttribute('aria-controls')}`);
        if (panel) panel.hidden = !selected;
      });
      if (focus) active.focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : event.key === 'ArrowLeft' ? (index - 1 + tabs.length) % tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : -1;
        if (next >= 0) { event.preventDefault(); activate(tabs[next], true); }
      });
    });
  });
</script>