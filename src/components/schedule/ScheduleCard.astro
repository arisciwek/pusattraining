---
import type { ScheduleEntry } from '../../lib/schedule-utils';
import {
  getScheduleDescription,
  getScheduleHref,
  getScheduleStatusLabel,
  getScheduleTitle,
} from '../../lib/schedule-utils';

interface Props {
  schedule: ScheduleEntry;
  trainingSlug: string;
  trainingTitle?: string;
  compact?: boolean;
  timelineStatus?: 'available' | 'ongoing' | 'past';
}

const { schedule, trainingSlug, trainingTitle, compact = false, timelineStatus } = Astro.props;
const data = schedule.data;
const href = getScheduleHref(schedule, trainingSlug);
const title = getScheduleTitle(schedule);
const description = getScheduleDescription(schedule);
const statusClass = `schedule-card__status--${timelineStatus ?? data.status}`;
const statusLabel = timelineStatus === 'available' ? 'Tersedia' : timelineStatus === 'ongoing' ? 'Sedang berlangsung' : timelineStatus === 'past' ? 'Sudah terlewati' : getScheduleStatusLabel(data.status);
---
<article
  class={['schedule-card group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-1 hover:border-amber-300 hover:shadow-lg hover:shadow-slate-900/5 sm:p-6', compact ? 'schedule-card--compact' : ''].filter(Boolean).join(' ')}
  data-start-date={data.startDate}
  data-end-date={data.endDate}
  data-timezone={data.timezone}
  data-editorial-status={data.status}
  data-timeline-status={timelineStatus}
>
  <div class="schedule-card__top flex flex-wrap items-center justify-between gap-3">
    <span class={['schedule-card__status inline-flex rounded-full px-3 py-1 text-xs font-bold', statusClass].join(' ')}>
      {statusLabel}
    </span>
    <span class="schedule-card__batch text-xs font-semibold text-slate-500">Angkatan {data.batchNo}</span>
  </div>
  <div class="schedule-card__body mt-5">
    {trainingTitle && <p class="schedule-card__training text-xs font-semibold text-amber-700">{trainingTitle}</p>}
    <h3 class="schedule-card__title mt-2 text-xl font-bold leading-snug tracking-tight text-slate-950">
      <a class="schedule-card__link outline-offset-4 hover:text-amber-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-slate-900" href={href}>{title}</a>
    </h3>
    <p class="schedule-card__date mt-3 flex items-start gap-2 text-sm font-semibold text-slate-700">
      <span aria-hidden="true">▦</span>
      <a
        class="schedule-card__date-link rounded-sm outline-offset-4 transition-colors hover:text-amber-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-slate-900"
        href={href}
        aria-label={`Lihat detail jadwal ${title}, ${data.dateLabel}`}
      >
        <time datetime={data.startDate}>{data.dateLabel}</time>
      </a>
    </p>
    {!compact && <p class="schedule-card__description mt-3 line-clamp-3 text-sm leading-6 text-slate-600">{description}</p>}
  </div>
  <div class="schedule-card__footer mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
    <span class="schedule-card__venue text-xs text-slate-500">{data.venue?.city ?? data.venue?.name ?? (data.delivery?.mode === 'online' ? 'Online' : data.delivery?.mode ? 'Lokasi menyusul' : 'Metode menyusul')}</span>
    <a class="schedule-card__action inline-flex items-center gap-2 text-sm font-bold text-slate-900 transition-colors hover:text-amber-700" href={href}>
      Detail jadwal <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
<style>
  .schedule-card[data-timeline-status='available'] { border-color: #86efac; background: #f0fdf4; }
  .schedule-card[data-timeline-status='ongoing'] { border-color: #facc15; background: #fefce8; }
  .schedule-card[data-timeline-status='past'] { border-color: #fca5a5; background: #fef2f2; }
  .schedule-card__status--scheduled,
  .schedule-card__status--available { background: #dcfce7; color: #166534; }
  .schedule-card__status--ongoing { background: #fef3c7; color: #92400e; }
  .schedule-card__status--completed,
  .schedule-card__status--past { background: #fee2e2; color: #991b1b; }
  .schedule-card__status--postponed { background: #fffbeb; color: #b45309; }
  .schedule-card__status--cancelled { background: #fef2f2; color: #b91c1c; }
</style>
