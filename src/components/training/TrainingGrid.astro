---
import TrainingCard from './TrainingCard.astro';

interface Training {
  title: string;
  href: string;
  description: string;
  category?: string;
  image?: string;
  imageAlt?: string;
  credential?: string;
  duration?: string;
  delivery?: string;
  organizer?: string;
}

interface Props {
  items: Training[];
  columns?: 2 | 3 | 4;
  class?: string;
}

const { items, columns = 3, class: className = '' } = Astro.props;
const columnClasses = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 xl:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4',
};
---

<div class={['training-grid grid grid-cols-1 gap-5 lg:gap-6', columnClasses[columns], className].filter(Boolean).join(' ')}>
  {items.map((item) => <TrainingCard {...item} />)}
</div>
