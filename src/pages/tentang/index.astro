---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/shared/Container.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import BlockRenderer from '../../blocks/BlockRenderer.astro';
import type { PageBlock } from '../../blocks/types';

const entry = (await getCollection('pages', ({ data }) =>
  data.slug === 'tentang' && !data.draft
))[0];

if (!entry) throw new Error('Konten halaman "tentang" tidak ditemukan.');

const { Content } = await render(entry);
const blocks = entry.data.blocks as PageBlock[];
---
<SiteLayout title={entry.data.title} description={entry.data.description}>
  <section class="content-page about-page py-12 sm:py-16">
    <Container>
      <Breadcrumb items={[{ label: 'Beranda', href: '/' }, { label: 'Tentang' }]} />
      <header class="content-page__header mt-8 max-w-4xl">
        <p class="content-page__eyebrow text-xs font-bold uppercase tracking-[0.18em] text-amber-700">TENTANG PORTAL</p>
        <h1 class="content-page__title mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">{entry.data.title}</h1>
        <p class="content-page__description mt-4 text-lg leading-8 text-slate-600">{entry.data.description}</p>
      </header>
      {blocks.length > 0 && <div class="content-page__blocks mt-10"><BlockRenderer blocks={blocks} /></div>}
      <article class="content-page__body mt-10 max-w-4xl space-y-5 text-base leading-8 text-slate-600 [&_h2]:pt-4 [&_h2]:text-2xl [&_h2]:font-extrabold [&_h2]:tracking-tight [&_h2]:text-slate-950 [&_p]:mt-3">
        <Content />
      </article>
    </Container>
  </section>
</SiteLayout>
