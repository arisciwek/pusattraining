---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/shared/Container.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import { CONTACT_PERSON, CONTACT_PHONE_DISPLAY, CONTACT_TEL_HREF, getContactWhatsAppHref } from '../../lib/contact';
import { resolveSiteTokensDeep } from '../../lib/site-tokens';

const entry = (await getCollection('pages', ({ data }) =>
  data.slug === 'kontak' && !data.draft
))[0];

if (!entry) throw new Error('Konten halaman "kontak" tidak ditemukan.');

const pageData = resolveSiteTokensDeep(entry.data);
const { Content } = await render(entry);
const whatsappHref = getContactWhatsAppHref(
  'Halo Tiara, saya ingin bertanya mengenai program pelatihan di Pusat Training.'
);
---
<SiteLayout title={pageData.title} description={pageData.description}>
  <section class="content-page contact-page py-12 sm:py-16">
    <Container>
      <Breadcrumb items={[{ label: 'Beranda', href: '/' }, { label: 'Kontak' }]} />
      <header class="content-page__header mt-8 max-w-3xl">
        <p class="content-page__eyebrow text-sm font-semibold tracking-wider text-amber-800">BANTUAN & INFORMASI</p>
        <h1 class="content-page__title mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">{pageData.title}</h1>
        <p class="content-page__description mt-4 text-lg leading-8 text-slate-600">{pageData.description}</p>
      </header>

      <div class="contact-page__layout mt-10 grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_21rem] lg:gap-12">
        <article class="contact-page__body order-2 space-y-7 text-base leading-8 text-slate-600 lg:order-1 [&_h2]:text-xl [&_h2]:font-extrabold [&_h2]:tracking-tight [&_h2]:text-slate-950 [&_p]:mt-3 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6 [&_li]:pl-1 [&_a]:font-semibold [&_a]:text-amber-800 [&_a]:underline [&_a]:decoration-amber-300 [&_a]:underline-offset-4 [&_a:hover]:text-amber-950">
          <Content />
        </article>

        <aside class="contact-page__card order-1 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-900/5 lg:sticky lg:top-28 lg:order-2" aria-labelledby="contact-page-card-title">
          <div class="contact-page__card-accent h-2 bg-amber-400"></div>
          <div class="contact-page__card-content p-6 sm:p-7">
            <p class="contact-page__card-eyebrow text-xs font-bold tracking-[0.16em] text-amber-800">KONTAK LANGSUNG</p>
            <h2 class="contact-page__card-title mt-3 text-2xl font-extrabold tracking-tight text-slate-950" id="contact-page-card-title">Bicarakan kebutuhan pelatihan Anda</h2>
            <p class="contact-page__card-description mt-3 text-sm leading-7 text-slate-600">Sampaikan program yang ingin Anda ikuti. {CONTACT_PERSON} akan membantu menindaklanjuti pertanyaan Anda.</p>

            <div class="contact-page__contact-person mt-6 rounded-xl bg-slate-50 p-4">
              <p class="contact-page__contact-label text-xs font-semibold uppercase tracking-wider text-slate-500">Narahubung</p>
              <p class="contact-page__contact-name mt-1 text-lg font-bold text-slate-950">{CONTACT_PERSON}</p>
              <a class="contact-page__contact-phone mt-1 inline-flex text-base font-semibold text-slate-700 hover:text-amber-800" href={CONTACT_TEL_HREF}>{CONTACT_PHONE_DISPLAY}</a>
            </div>

            <div class="contact-page__actions mt-5 grid gap-3">
              <a class="contact-page__action contact-page__action--whatsapp inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-amber-400 px-5 py-3 text-sm font-extrabold text-slate-950 transition hover:bg-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600" href={whatsappHref} target="_blank" rel="noopener noreferrer">
                Chat melalui WhatsApp <span aria-hidden="true">↗</span>
              </a>
              <a class="contact-page__action contact-page__action--phone inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-200 px-5 py-3 text-sm font-bold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50" href={CONTACT_TEL_HREF}>
                Telepon langsung
              </a>
            </div>
            <p class="contact-page__card-note mt-5 text-xs leading-6 text-slate-500">Untuk pertanyaan yang lebih spesifik, siapkan nama program atau tautan jadwal yang ingin Anda tanyakan.</p>
          </div>
        </aside>
      </div>
    </Container>
  </section>
</SiteLayout>
