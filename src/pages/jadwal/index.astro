---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/shared/Container.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import EmptyState from '../../components/shared/EmptyState.astro';
import ScheduleCard from '../../components/schedule/ScheduleCard.astro';
import { getScheduleMonth, isMainSiteSchedule } from '../../lib/schedule-utils';
import { validateContentRelations } from '../../lib/validate-content';

const page = (await getCollection('pages', ({ data }) =>
  data.slug === 'jadwal' && !data.draft
))[0];

if (!page) throw new Error('Konten halaman Jadwal (slug: jadwal) tidak ditemukan.');

const pageBlock = page.data.blocks.find((block) => block.type === 'schedule-index');

if (!pageBlock) throw new Error('Block schedule-index belum dikonfigurasi pada src/content/pages/jadwal.md.');

await validateContentRelations();
const [allSchedules, trainings] = await Promise.all([
  getCollection('schedules', isMainSiteSchedule),
  getCollection('trainings', ({ data }) => !data.draft),
]);
const trainingsById = new Map(trainings.map((training) => [training.data.trainingId, training]));
const schedules = allSchedules.filter((schedule) => trainingsById.has(schedule.data.trainingId));
const today = new Date().toISOString().slice(0, 10);
const upcomingSchedules = schedules
  .filter((schedule) => schedule.data.startDate.slice(0, 10) >= today)
  .sort((a, b) => Date.parse(a.data.startDate) - Date.parse(b.data.startDate));
const latestSchedules = (upcomingSchedules.length > 0
  ? upcomingSchedules
  : [...schedules].sort((a, b) => Date.parse(b.data.startDate) - Date.parse(a.data.startDate))
).slice(0, 6);
const archiveMonths = [...new Set(schedules.map((schedule) => getScheduleMonth(schedule.data)))].sort().reverse();
const monthLabel = (value: string) => {
  const [year, month] = value.split('-').map(Number);
  return new Intl.DateTimeFormat('id-ID', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(year, month - 1, 1)));
};
---
<SiteLayout title={page.data.title} description={page.data.description}>
  <section class="schedule-index py-12 sm:py-16">
    <Container>
      <Breadcrumb items={[{ label: 'Beranda', href: '/' }, { label: page.data.title }]} />
      <header class="schedule-index__header mt-8 max-w-3xl">
        {pageBlock.eyebrow && <p class="schedule-index__eyebrow text-xs font-bold uppercase tracking-[0.18em] text-amber-700">{pageBlock.eyebrow}</p>}
        <h1 class="schedule-index__title mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">{page.data.title}</h1>
        <p class="schedule-index__description mt-4 text-base leading-8 text-slate-600">{page.data.description}</p>
      </header>

      {schedules.length > 0 ? (
        <>
          <section class="schedule-index__latest mt-12">
            <div class="schedule-index__section-heading flex flex-wrap items-end justify-between gap-4">
              <div>
                {pageBlock.sectionEyebrow && <p class="schedule-index__section-eyebrow text-xs font-bold uppercase tracking-[0.14em] text-amber-700">{pageBlock.sectionEyebrow}</p>}
                <h2 class="schedule-index__section-title mt-2 text-2xl font-bold tracking-tight text-slate-950">{pageBlock.latestTitle}</h2>
              </div>
              <p class="schedule-index__total text-sm text-slate-500">{schedules.length} batch tersedia</p>
            </div>
            <div class="schedule-index__grid mt-6 grid gap-5 lg:grid-cols-2">
              {latestSchedules.map((schedule) => {
                const training = trainingsById.get(schedule.data.trainingId)!;
                return <ScheduleCard schedule={schedule} trainingSlug={training.data.slug} trainingTitle={training.data.title} />;
              })}
            </div>
          </section>
          {archiveMonths.length > 0 && (
            <nav class="schedule-index__archive mt-14 border-t border-slate-200 pt-8" aria-label="Arsip jadwal per bulan">
              <h2 class="schedule-index__archive-title text-xl font-bold text-slate-950">{pageBlock.archiveTitle}</h2>
              <ul class="schedule-index__archive-list mt-5 flex flex-wrap gap-3">
                {archiveMonths.map((month) => (
                  <li>
                    <a class="schedule-index__archive-link inline-flex rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-amber-400 hover:text-amber-700" href={`/jadwal/${month}/`}>{monthLabel(month)} <span class="ml-2 text-slate-400" aria-hidden="true">→</span></a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
        </>
      ) : (
        <div class="schedule-index__content mt-10">
          <EmptyState title={pageBlock.emptyTitle} description={pageBlock.emptyDescription} actionLabel={pageBlock.emptyActionLabel} actionHref="/pelatihan/" />
        </div>
      )}
    </Container>
  </section>
</SiteLayout>
