---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/shared/Container.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import EmptyState from '../../components/shared/EmptyState.astro';
import ScheduleCard from '../../components/schedule/ScheduleCard.astro';
import {
  formatScheduleDate,
  getScheduleMonth,
  getScheduleTitle,
  isMainSiteSchedule,
} from '../../lib/schedule-utils';
import { validateContentRelations } from '../../lib/validate-content';

export async function getStaticPaths() {
  await validateContentRelations();
  const [schedules, trainings] = await Promise.all([
    getCollection('schedules', isMainSiteSchedule),
    getCollection('trainings', ({ data }) => !data.draft),
  ]);
  const trainingsById = new Map(trainings.map((training) => [training.data.trainingId, training]));
  const months = [...new Set(schedules.map((schedule) => getScheduleMonth(schedule.data)))].sort().reverse();

  return months.map((month) => {
    const monthSchedules = schedules
      .filter((schedule) => getScheduleMonth(schedule.data) === month)
      .sort((a, b) => Date.parse(a.data.startDate) - Date.parse(b.data.startDate));

    return {
      params: { month },
      props: {
        month,
        schedules: monthSchedules,
        trainingsById: Object.fromEntries(trainingsById),
      },
    };
  });
}

const { month, schedules, trainingsById } = Astro.props;
const [year, monthNumber] = month.split('-').map(Number);
const monthDate = new Date(Date.UTC(year, monthNumber - 1, 1));
const monthLabel = new Intl.DateTimeFormat('id-ID', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(monthDate);
const title = `Jadwal Training ${monthLabel}`;
const description = `Daftar jadwal training yang diselenggarakan pada ${monthLabel}, lengkap dengan informasi program dan batch.`;
---
<SiteLayout title={title} description={description}>
  <section class="schedule-archive py-12 sm:py-16">
    <Container>
      <Breadcrumb items={[
        { label: 'Beranda', href: '/' },
        { label: 'Jadwal Training', href: '/jadwal/' },
        { label: monthLabel },
      ]} />
      <header class="schedule-archive__header mt-8 max-w-3xl">
        <p class="schedule-archive__eyebrow text-xs font-bold uppercase tracking-[0.18em] text-amber-700">ARSIP JADWAL</p>
        <h1 class="schedule-archive__title mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">{title}</h1>
        <p class="schedule-archive__description mt-4 text-base leading-8 text-slate-600">{description}</p>
        <p class="schedule-archive__count mt-5 text-sm font-semibold text-slate-500">{schedules.length} jadwal dipublikasikan</p>
      </header>
      {schedules.length > 0 ? (
        <div class="schedule-archive__grid mt-10 grid gap-5 lg:grid-cols-2">
          {schedules.map((schedule) => {
            const training = trainingsById[schedule.data.trainingId];
            return (
              <ScheduleCard
                schedule={schedule}
                trainingSlug={training.data.slug}
                trainingTitle={training.data.title}
              />
            );
          })}
        </div>
      ) : (
        <div class="schedule-archive__empty mt-10">
          <EmptyState title="Belum ada jadwal pada bulan ini" description="Silakan kembali ke arsip jadwal untuk melihat bulan lainnya." actionLabel="Lihat semua jadwal" actionHref="/jadwal/" />
        </div>
      )}
    </Container>
  </section>
</SiteLayout>
