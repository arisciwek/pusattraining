---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/shared/Container.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import TrainingCategoryOverview from '../../blocks/home/TrainingCategoryOverview.astro';

const categories = (await getCollection('pages', ({ data }) =>
  data.pageType === 'category' && !data.draft
)).sort((a, b) => a.data.title.localeCompare(b.data.title, 'id'));

const categoryItems = categories.map(({ data }) => ({
  title: data.title,
  description: data.description,
  href: `/pelatihan/${data.slug}/`,
}));
---
<SiteLayout title="Katalog Pelatihan" description="Jelajahi kategori dan program pelatihan K3 berdasarkan bidang kompetensi." canonicalURL="https://pusattrainingk3.com/pelatihan/">
  <section class="training-index py-12 sm:py-16">
    <Container>
      <Breadcrumb items={[{ label: 'Beranda', href: '/' }, { label: 'Pelatihan' }]} />
      <header class="training-index__header mt-8 max-w-3xl">
        <p class="training-index__eyebrow text-sm font-semibold text-amber-800">KATALOG PROGRAM</p>
        <h1 class="training-index__title mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Jelajahi kategori pelatihan</h1>
        <p class="training-index__description mt-4 text-base leading-8 text-slate-600">Temukan rumpun kompetensi dan telusuri program pelatihan berdasarkan bidang yang dibutuhkan.</p>
      </header>
      {categoryItems.length > 0 ? (
        <div class="training-index__content mt-10">
          <TrainingCategoryOverview categories={categoryItems} />
        </div>
      ) : (
        <p class="training-index__empty mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-slate-600">Kategori pelatihan sedang disiapkan.</p>
      )}
    </Container>
  </section>
</SiteLayout>
