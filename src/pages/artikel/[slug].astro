---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/shared/Container.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import { COMPANY_NAME, COMPANY_URL, DEFAULT_ARTICLE_IMAGE } from '../../lib/site';
import Hero from '../../components/content/Hero.astro';
import ArticlePreviousArticles from '../../components/content/ArticlePreviousArticles.astro';
import ArticleIndexListing from '../../components/content/ArticleIndexListing.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  const articlePaths = articles.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
  const pageSize = 9;
  const totalPages = Math.ceil(articles.length / pageSize);
  const paginationPaths = Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { slug: String(index + 2) },
    props: { paginationPage: index + 2 },
  }));
  return [...articlePaths, ...paginationPaths];
}

const { entry, paginationPage } = Astro.props;
const isPaginationPage = typeof paginationPage === 'number';
const allArticles = (await getCollection('articles', ({ data: item }) => !item.draft))
  .sort((a, b) => Date.parse(b.data.pubDate) - Date.parse(a.data.pubDate)
    || b.data.slug.localeCompare(a.data.slug));
const pageSize = 9;
const totalPages = Math.max(1, Math.ceil(allArticles.length / pageSize));
const pageArticles = isPaginationPage
  ? allArticles.slice((paginationPage - 1) * pageSize, paginationPage * pageSize)
  : [];
const categories = [...new Set(allArticles.map(({ data: item }) => item.category))]
  .sort((a, b) => a.localeCompare(b, 'id'));
const data = entry?.data ?? {
  id: 0, slug: '', title: '', description: '', pubDate: '', author: '',
  category: '', tags: [], image: undefined, blocks: [], serviceIds: [], related: [],
};
const { Content } = entry ? await render(entry) : { Content: undefined };
const articles = allArticles;
const hasPreviousArticles = articles.some((item) =>
  item.id !== entry?.id && Date.parse(item.data.pubDate) < Date.parse(data.pubDate)
);
const services = isPaginationPage ? [] : await getCollection('services', ({ data: service }) => !service.draft);
const relatedServices = services.filter((service) => data.serviceIds.includes(service.data.id));
const trainings = isPaginationPage ? [] : await getCollection('trainings', ({ data: training }) => !training.draft);
const relatedTrainings = trainings.filter((training) => data.related.includes(training.data.id));
const relatedTrainingTitles = relatedTrainings.map((training) => training.data.title);
const relatedServiceTitles = relatedServices.map((service) => service.data.title);

const footerDescription = relatedTrainingTitles.length
  ? `${COMPANY_NAME} menyelenggarakan pelatihan ${relatedTrainingTitles.join(', ')}.`
  : relatedServiceTitles.length
    ? `${COMPANY_NAME} menyediakan layanan ${relatedServiceTitles.join(', ')}.`
    : undefined;
const formatDate = (value: string) => new Date(value).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Jakarta',
});

const articleImage = new URL(data.image || DEFAULT_ARTICLE_IMAGE, Astro.site).href;
const canonicalUrl = new URL(`/artikel/${data.slug}/`, Astro.site).href;
const isBrochure = data.type === 'brochure';
const structuredData = isBrochure
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: data.title,
      description: data.description,
      url: canonicalUrl,
      datePublished: data.pubDate,
      dateModified: data.updatedDate || data.pubDate,
      author: {
        '@type': 'Organization',
        name: data.author,
        url: COMPANY_URL,
      },
      publisher: {
        '@type': 'Organization',
        name: COMPANY_NAME,
        url: COMPANY_URL,
      },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: articleImage,
      },
      inLanguage: 'id-ID',
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: data.title,
      description: data.description,
      image: [articleImage],
      datePublished: data.pubDate,
      dateModified: data.updatedDate || data.pubDate,
      author: {
        '@type': 'Organization',
        name: data.author,
        url: COMPANY_URL,
      },
      publisher: {
        '@type': 'Organization',
        name: COMPANY_NAME,
        url: COMPANY_URL,
      },
      articleSection: data.category,
      keywords: data.tags,
      inLanguage: 'id-ID',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
      },
    };
---

{isPaginationPage ? (
  <SiteLayout
    title={`Artikel dan Informasi Pelatihan — Halaman ${paginationPage}`}
    description="Jelajahi artikel dan informasi pelatihan terbaru."
    canonicalURL={new URL(`/artikel/${paginationPage}/`, Astro.site).href}
  >
    <section class="article-index overflow-hidden bg-slate-950 py-14 text-white sm:py-20">
      <Container>
        <Breadcrumb items={[
          { label: 'Beranda', href: '/' },
          { label: 'Artikel', href: '/artikel/' },
          { label: `Halaman ${paginationPage}` },
        ]} />
        <div class="article-index__hero mt-10 max-w-3xl">
          <p class="article-index__eyebrow text-sm font-semibold text-amber-300">Wawasan & referensi</p>
          <h1 class="article-index__title mt-4 text-4xl font-black tracking-tight sm:text-5xl">Artikel dan Informasi Pelatihan</h1>
          <p class="article-index__description mt-5 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">Lanjutkan membaca panduan, penjelasan program, dan informasi praktis seputar pelatihan serta sertifikasi kompetensi.</p>
          <p class="article-index__count mt-7 text-sm font-semibold text-amber-200">{allArticles.length} materi tersedia</p>
        </div>
      </Container>
    </section>
    <ArticleIndexListing articles={pageArticles} categories={categories} page={paginationPage} totalPages={totalPages} />
  </SiteLayout>
) : (
<SiteLayout title={data.title} description={data.description} footerDescription={footerDescription} ogType={isBrochure ? 'website' : 'article'}>
  <Fragment slot="head">
    <meta property="og:image" content={articleImage} />
    <meta name="twitter:image" content={articleImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>
  <article class="article-detail py-10 sm:py-14">
    <Container>
      <Breadcrumb items={[
        { label: 'Beranda', href: '/' },
        { label: 'Artikel', href: '/artikel/' },
        { label: data.title },
      ]} />
      <Hero
        eyebrow={data.category}
        heading={data.title}
        lead={data.description}
        image={data.image}
        imageAlt={data.image ? data.title : `Ilustrasi artikel ${data.title}`}
      />

      <div class="article-detail__layout mt-10 grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_16rem] xl:gap-10">
        <div class="article-detail__main min-w-0">
          <div class="article-detail__body max-w-4xl space-y-12">
        {data.blocks.map((block) => (
          block.type === 'intro' ? (
            <section class="article-detail__intro rounded-3xl bg-slate-950 px-6 py-8 text-white sm:px-9 sm:py-10">
              {block.eyebrow && <p class="article-detail__intro-eyebrow text-sm font-semibold text-amber-300">{block.eyebrow}</p>}
              <p class="article-detail__intro-lead mt-3 text-lg leading-8 text-slate-100 sm:text-xl">{block.lead}</p>
            </section>
          ) : block.type === 'section' ? (
            <section class="article-detail__section">
              <h2 class="article-detail__section-title text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">{block.title}</h2>
              {block.paragraphs.map((paragraph) => <p class="article-detail__paragraph mt-4 text-base leading-8 text-slate-600">{paragraph}</p>)}
              {block.items.length > 0 && (
                <div class="article-detail__items mt-6 grid gap-4 sm:grid-cols-2">
                  {block.items.map((item) => (
                    <article class="article-detail__item rounded-2xl border border-slate-200 bg-white p-5">
                      <h3 class="article-detail__item-title font-semibold text-slate-950">{item.title}</h3>
                      <p class="article-detail__item-description mt-2 text-sm leading-7 text-slate-600">{item.description}</p>
                    </article>
                  ))}
                </div>
              )}
            </section>
          ) : block.type === 'schedule-note' ? (
            <section class="article-detail__schedule rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
              <p class="article-detail__schedule-eyebrow text-sm font-semibold text-amber-800">{block.period}</p>
              <h2 class="article-detail__schedule-title mt-2 text-2xl font-bold text-slate-950">{block.title}</h2>
              <dl class="article-detail__schedule-list mt-5 grid gap-3 sm:grid-cols-2">
                {block.items.map((item) => (
                  <div class="article-detail__schedule-item rounded-xl bg-white p-4">
                    <dt class="article-detail__schedule-label text-xs font-semibold text-slate-500">{item.label}</dt>
                    <dd class="article-detail__schedule-value mt-1 font-semibold text-slate-900">{item.value}</dd>
                  </div>
                ))}
              </dl>
              <p class="article-detail__schedule-note mt-5 text-sm leading-7 text-slate-600">{block.note}</p>
            </section>
          ) : (
            <section class="article-detail__service-cta rounded-3xl bg-slate-100 p-6 sm:p-8">
              <h2 class="article-detail__service-title text-2xl font-bold text-slate-950">{block.title}</h2>
              <p class="article-detail__service-description mt-3 text-base leading-8 text-slate-600">{block.description}</p>
              {relatedServices.length > 0 ? (
                <div class="article-detail__service-links mt-6 flex flex-wrap gap-3">
                  {relatedServices.map((service) => (
                    <a class="article-detail__service-link inline-flex rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-amber-800" href={`/layanan/${service.data.slug}/`}>{block.actionLabel}</a>
                  ))}
                </div>
              ) : (
                <a class="article-detail__service-link mt-6 inline-flex rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white" href={block.actionHref || "/layanan/"}>{block.actionLabel}</a>
              )}
            </section>
          )
        ))}
          </div>
        </div>

        {hasPreviousArticles && (
          <aside class="article-detail__aside min-w-0" aria-label="Navigasi artikel sebelumnya">
            <div class="article-detail__aside-inner lg:sticky lg:top-28">
              <ArticlePreviousArticles article={entry} articles={articles} />
            </div>
          </aside>
        )}
      </div>
    </Container>
  </article>
</SiteLayout>
)}