---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/shared/Container.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import { DEFAULT_ARTICLE_IMAGE } from '../../lib/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => Date.parse(b.data.pubDate) - Date.parse(a.data.pubDate));

const formatDate = (value: string) => new Date(value).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Jakarta',
});

const categories = [...new Set(articles.map(({ data }) => data.category))]
  .sort((a, b) => a.localeCompare(b, 'id'));
---
<SiteLayout
  title="Artikel dan Informasi Pelatihan"
  description="Baca panduan, informasi program, dan materi seputar pelatihan, sertifikasi kompetensi, serta keselamatan dan kesehatan kerja."
>
  <section class="article-index overflow-hidden bg-slate-950 py-14 text-white sm:py-20">
    <Container>
      <Breadcrumb items={[
        { label: 'Beranda', href: '/' },
        { label: 'Artikel' },
      ]} />
      <div class="article-index__hero mt-10 max-w-3xl">
        <p class="article-index__eyebrow text-sm font-semibold text-amber-300">Wawasan & referensi</p>
        <h1 class="article-index__title mt-4 text-4xl font-black tracking-tight sm:text-5xl">Artikel dan Informasi Pelatihan</h1>
        <p class="article-index__description mt-5 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
          Temukan panduan, penjelasan program, dan informasi praktis seputar pelatihan serta sertifikasi kompetensi untuk mendukung pengembangan profesional.
        </p>
        <p class="article-index__count mt-7 text-sm font-semibold text-amber-200">{articles.length} materi tersedia</p>
      </div>
    </Container>
  </section>

  <section class="article-index__content py-12 sm:py-16">
    <Container>
      {categories.length > 0 && (
        <div class="article-index__categories mb-8 flex flex-wrap gap-2" aria-label="Kategori materi">
          {categories.map((category) => (
            <span class="article-index__category rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600">{category}</span>
          ))}
        </div>
      )}

      {articles.length > 0 ? (
        <div class="article-index__grid grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {articles.map(({ data }) => (
            <article class="article-index__card group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-200 hover:-translate-y-1 hover:border-amber-300 hover:shadow-xl hover:shadow-slate-200/60">
              <a class="article-index__card-image-link block aspect-[16/9] overflow-hidden bg-slate-100" href={`/artikel/${data.slug}/`} aria-label={`Baca ${data.title}`}>
                <img class="article-index__card-image h-full w-full object-cover transition duration-300 group-hover:scale-105" src={data.image || DEFAULT_ARTICLE_IMAGE} alt={data.image ? data.title : ''} loading="lazy" decoding="async" />
              </a>
              <div class="article-index__card-content flex flex-1 flex-col p-6">
                <div class="article-index__card-meta flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-semibold text-slate-500">
                  <span class="article-index__card-category">{data.category}</span>
                </div>
                <h2 class="article-index__card-title mt-4 text-xl font-bold leading-snug tracking-tight text-slate-950">
                  <a class="article-index__card-title-link transition-colors group-hover:text-amber-800" href={`/artikel/${data.slug}/`}>{data.title}</a>
                </h2>
                <p class="article-index__card-description mt-3 line-clamp-3 text-sm leading-7 text-slate-600">{data.description}</p>
                <div class="article-index__card-footer mt-auto flex items-center justify-between gap-4 pt-6">
                  <time class="article-index__card-date text-xs text-slate-500" datetime={data.pubDate}>{formatDate(data.pubDate)}</time>
                  <a class="article-index__card-read inline-flex items-center gap-2 text-sm font-bold text-amber-800" href={`/artikel/${data.slug}/`}>
                    Baca materi <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="article-index__empty rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
          <h2 class="article-index__empty-title text-xl font-bold text-slate-900">Belum ada materi yang diterbitkan</h2>
          <p class="article-index__empty-description mt-3 text-sm leading-7 text-slate-600">Materi artikel dan informasi pelatihan akan ditampilkan di halaman ini.</p>
        </div>
      )}
    </Container>
  </section>
</SiteLayout>
