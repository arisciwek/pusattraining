---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import HomePageRenderer from '../blocks/home/HomePageRenderer.astro';
import { formatScheduleRange, isMainSiteSchedule } from '../lib/schedule-utils';

const entry = (await getCollection('pages', ({ data }) => data.slug === 'home' && !data.draft))[0];

if (!entry) {
  throw new Error('Konten halaman Beranda (slug: home) tidak ditemukan.');
}

const categories = (await getCollection('pages', ({ data }) => data.pageType === 'category' && !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'id'))
  .map(({ data }) => ({
    title: data.title,
    description: data.description,
    href: `/pelatihan/${data.slug}/`,
  }));

const now = new Date();
const schedules = await getCollection('schedules', isMainSiteSchedule);
const trainings = await getCollection('trainings', ({ data }) => !data.draft);
const trainingsById = new Map(trainings.map((training) => [training.data.trainingId, training]));

const todayInTimezone = (timezone: string) => new Intl.DateTimeFormat('en-CA', {
  timeZone: timezone,
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(now);

const upcomingSchedules = schedules
  .filter((schedule) => {
    const { status, endDate, timezone } = schedule.data;
    if (status === 'completed' || status === 'cancelled' || status === 'postponed') return false;

    const today = todayInTimezone(timezone);
    const endDay = /^\d{4}-\d{2}-\d{2}$/.test(endDate)
      ? endDate
      : new Intl.DateTimeFormat('en-CA', {
          timeZone: timezone,
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }).format(new Date(endDate));
    return endDay >= today;
  })
  .sort((a, b) => Date.parse(a.data.startDate) - Date.parse(b.data.startDate))
  .reduce<Array<{
    trainingTitle: string;
    trainingHref: string;
    startDate: string;
    endDate: string;
    dateLabel: string;
    mode: string;
    location?: string;
    registrationHref?: string;
    image?: string;
    imageAlt: string;
  }>>((items, schedule) => {
    const training = trainingsById.get(schedule.data.trainingId);
    if (!training || items.some((item) => item.trainingHref === `/pelatihan/${training.data.slug}/`)) {
      return items;
    }

    const modeLabels = {
      offline: 'Offline',
      online: 'Online',
      blended: 'Blended',
    } as const;

    items.push({
      trainingTitle: training.data.title,
      trainingHref: `/pelatihan/${training.data.slug}/`,
      startDate: schedule.data.startDate,
      endDate: schedule.data.endDate,
      dateLabel: schedule.data.dateLabel || formatScheduleRange(schedule.data.startDate, schedule.data.endDate, schedule.data.timezone),
      mode: modeLabels[schedule.data.delivery?.mode ?? 'offline'],
      location: schedule.data.venue?.name,
      registrationHref: schedule.data.sites?.main?.registrationUrl,
      image: schedule.data.image ?? training.data.image,
      imageAlt: training.data.title,
    });

    return items;
  }, []);
---

<SiteLayout title={entry.data.title} description={entry.data.description}>
  <HomePageRenderer
    blocks={entry.data.blocks as any}
    categories={categories}
    upcomingSchedules={upcomingSchedules}
  />
</SiteLayout>
