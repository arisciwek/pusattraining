---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/shared/Container.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import BlockRenderer from '../../blocks/BlockRenderer.astro';
import type { PageBlock } from '../../blocks/types';
import ScheduleCard from '../../components/schedule/ScheduleCard.astro';
import { isMainSiteSchedule } from '../../lib/schedule-utils';
import { validateContentRelations } from '../../lib/validate-content';

const trainings = await getCollection('trainings', ({ data }) => !data.draft);
const schedules = await getCollection('schedules', isMainSiteSchedule);

export async function getStaticPaths() {
  await validateContentRelations();
  const categories = await getCollection('pages', ({ data }) =>
    data.pageType === 'category' && !data.draft
  );
  const trainings = await getCollection('trainings', ({ data }) => !data.draft);

  return [
    ...categories.map((entry) => ({
      params: { slug: entry.data.slug },
      props: { kind: 'category', entry },
    })),
    ...trainings.map((entry) => ({
      params: { slug: entry.data.slug },
      props: { kind: 'training', entry },
    })),
  ];
}

const { kind, entry } = Astro.props;
const relatedTrainings = kind === 'category'
  ? trainings.filter((training) => training.data.categoryIds.includes(entry.data.id))
  : [];
const relatedSchedules = kind === 'training'
  ? schedules
      .filter((schedule) => schedule.data.trainingId === entry.data.trainingId)
      .sort((a, b) => Date.parse(a.data.startDate) - Date.parse(b.data.startDate))
  : [];
const title = entry.data.title;
const description = entry.data.description;
const categoryBlocks = kind === 'category' ? entry.data.blocks as PageBlock[] : [];
const categoryTrainingCards = relatedTrainings.map((training) => ({
  title: training.data.title,
  description: training.data.description,
  href: `/pelatihan/${training.data.slug}/`,
}));
---
<SiteLayout title={title} description={description}>
  <section class="training-detail py-12 sm:py-16">
    <Container>
      <Breadcrumb items={[
        { label: 'Beranda', href: '/' },
        { label: 'Pelatihan', href: '/pelatihan/' },
        { label: title },
      ]} />

      {kind === 'category' ? (
        <div class="training-detail__category-content mt-8">
          <BlockRenderer
            blocks={categoryBlocks}
            pageTitle={title}
            pageDescription={description}
            categoryTrainings={categoryTrainingCards}
          />
        </div>
      ) : (
        <>
          <header class="training-detail__header mt-8 max-w-4xl">
            <p class="training-detail__eyebrow text-xs font-bold uppercase tracking-[0.18em] text-amber-700">PROGRAM PELATIHAN</p>
            <h1 class="training-detail__title mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">{title}</h1>
            <p class="training-detail__description mt-4 text-base leading-8 text-slate-600">{description}</p>
          </header>

          <div class="training-detail__content mt-10 max-w-3xl">
            <div class="training-detail__notice rounded-2xl border border-slate-200 bg-slate-50 p-6">
              <h2 class="training-detail__notice-title text-lg font-bold text-slate-950">Informasi program</h2>
              <p class="training-detail__notice-description mt-2 leading-7 text-slate-600">Rincian materi, persyaratan, metode, dan skema pelaksanaan program ini akan dilengkapi secara bertahap.</p>
            </div>
          </div>

          <section class="training-detail__schedules mt-12">
            <div class="training-detail__schedules-heading flex flex-wrap items-end justify-between gap-4">
              <div>
                <p class="training-detail__schedules-eyebrow text-xs font-bold uppercase tracking-[0.14em] text-amber-700">BATCH TERSEDIA</p>
                <h2 class="training-detail__schedules-title mt-2 text-2xl font-bold tracking-tight text-slate-950">Jadwal pelatihan</h2>
              </div>
              {relatedSchedules.length > 0 && <a class="training-detail__all-schedules text-sm font-semibold text-slate-600 hover:text-amber-700" href="/jadwal/">Semua jadwal <span aria-hidden="true">→</span></a>}
            </div>
            {relatedSchedules.length > 0 ? (
              <div class="training-detail__schedule-grid mt-6 grid gap-5 lg:grid-cols-2">
                {relatedSchedules.map((schedule) => <ScheduleCard schedule={schedule} trainingSlug={entry.data.slug} />)}
              </div>
            ) : (
              <p class="training-detail__schedule-empty mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-sm leading-7 text-slate-600">Belum ada batch yang dipublikasikan untuk program ini. Jadwal akan ditampilkan setelah data penyelenggaraan tersedia.</p>
            )}
          </section>
        </>
      )}
    </Container>
  </section>
</SiteLayout>
