---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/shared/Container.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import BlockRenderer from '../../blocks/BlockRenderer.astro';
import type { PageBlock } from '../../blocks/types';

const [entry, categoryEntries, trainings] = await Promise.all([
  getCollection('pages', ({ data }) => data.slug === 'pelatihan' && !data.draft).then((entries) => entries[0]),
  getCollection('pages', ({ data }) => data.pageType === 'category' && !data.draft),
  getCollection('trainings', ({ data }) => !data.draft),
]);

if (!entry) throw new Error('Konten halaman Pelatihan (slug: pelatihan) tidak ditemukan.');

const categories = categoryEntries
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'id'))
  .map(({ data }) => {
    const programCount = trainings.filter((training) =>
      training.data.categoryIds.includes(data.id)
    ).length;

    return {
      title: data.title,
      description: data.description,
      href: `/pelatihan/${data.slug}/`,
      count: programCount > 0 ? `${programCount} program` : 'Segera hadir',
    };
  });

const blocks = entry.data.blocks as PageBlock[];
---
<SiteLayout title={entry.data.title} description={entry.data.description}>
  <section class="training-catalog-page py-12 sm:py-16">
    <Container>
      <Breadcrumb items={[{ label: 'Beranda', href: '/' }, { label: entry.data.title }]} />
      <div class="training-catalog-page__content mt-8">
        <BlockRenderer blocks={blocks} categories={categories} />
      </div>
    </Container>
  </section>
</SiteLayout>
